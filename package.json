{
  "name": "diary-api",
  "version": "0.0.1",
  "description": "Travel diary API built with Elysia and Bun",
  "author": "Elias Chen",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build --minify src/index.ts --outfile dist/index.js",
    "start": "bun src/index.ts",
    "test": "bun test"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@elysiajs/openapi": "^1.4.14",
    "@elysiajs/swagger": "^1.3.1",
    "elysia": "^1.4.28"
  }
}
